{
  "name": "interalia-website",
  "version": "1.0.0",
  "description": "Website for interalia - fiscal hosting for civil society",
  "scripts": {
    "dev": "concurrently \"npm run css:watch\" \"npm run hugo:dev\"",
    "build": "npm run css:build && npm run hugo:build",
    "css:build": "npx @tailwindcss/cli -i ./assets/tailwind.css -o ./assets/style.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./assets/tailwind.css -o ./assets/style.css --watch",
    "hugo:dev": "hugo server --buildDrafts --buildFuture",
    "hugo:build": "hugo --minify"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/interalia-host/website"
  },
  "keywords": [
    "interalia",
    "fiscal-host",
    "civil-society",
    "hugo",
    "nonprofit"
  ],
  "license": "MIT",
  "homepage": "https://interalia.host",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.8"
  }
}
